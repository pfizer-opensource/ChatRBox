Package: ChatRBox
Title: Your Chatbot Development Toolkit
Version: 0.2.7
Authors@R: 
    c(
      person("Abigail", "Barnett", email = "Abigail.Barnett@pfizer.com", role = c("aut", "cre"), comment = c(ORCID = "0009-0009-1441-4929")),
      person("Richard", "Virgen-Slane", email = "Richard.Virgen-Slane@pfizer.com", role = "aut", comment = c(ORCID = "0000-0002-0011-3844"))
