# chatbot object in-place
# Here, the existing S7 tools environment is a default
update <- object_update(object = object,
                        tools_list = list(subtract_two_numbers = subtract))

# Extracts tool environment from updated S7 object
updated_tools <- get_property(update, "tools_env")

# This contains the 'add' and 'subtract' functions
ls(updated_tools)

# This converts contents of updated_tools into list for AI prompt
env_to_str(updated_tools)
}
